# ============================================================
# The Ai Advantage Co. — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git.
# ============================================================

# Shared client password for the guide library.
# Format for quarterly rotation: <season>-<year>-aiadv  (e.g. autumn-2026-aiadv)
# Set a DIFFERENT value on Vercel Preview vs Production.
GUIDES_PASSWORD=your-password-here

# HMAC key for signing the access cookie.
# Generate: openssl rand -base64 32
# Rotating this key invalidates all existing cookies immediately on redeploy.
COOKIE_SECRET=your-cookie-secret-here

# Vercel KV — rate limiting store (production only).
# Leave blank for local dev — falls back to in-memory map.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
